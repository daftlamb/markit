<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Mark It ✦</title>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500&family=IM+Fell+English:ital@0;1&family=Special+Elite&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#f5f0e8;--paper:#faf6ee;--ink:#1a1410;--muted:#7a6e60;
  --border:#d8cfc0;--accent:#2a2a2a;--header-h:48px;
}
html,body{height:100%;overflow:hidden;background:var(--bg);font-family:'Outfit',sans-serif;font-size:13px;color:var(--ink)}

/* HEADER */
header{
  height:var(--header-h);background:var(--paper);border-bottom:1px solid var(--border);
  display:flex;align-items:center;padding:0 20px;gap:12px;flex-shrink:0;z-index:100;position:relative;
}
.brand{font-family:'Special Elite',monospace;font-size:16px;letter-spacing:.04em;color:var(--ink)}
.brand span{color:#c0392b}
.sep{flex:1}
.btn{height:30px;border:1px solid var(--border);background:transparent;border-radius:4px;
  cursor:pointer;color:var(--ink);font-family:inherit;font-size:12px;padding:0 12px;
  transition:border-color .15s,color .15s;letter-spacing:.04em}
.btn:hover{border-color:var(--ink);color:var(--ink)}
.btn.danger{border-color:#c0392b;color:#c0392b}
.btn.danger:hover{background:#c0392b;color:#fff}

/* LAYOUT */
#layout{display:flex;flex:1;height:calc(100vh - var(--header-h));overflow:hidden}

/* PANEL */
#panel{
  width:240px;flex-shrink:0;background:var(--paper);border-right:1px solid var(--border);
  display:flex;flex-direction:column;padding:16px 14px;gap:14px;overflow-y:auto;
}
.ps-t{font-size:9px;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);margin-bottom:8px;font-weight:500}
.tool-btn{
  width:100%;height:32px;border:1px solid var(--border);background:transparent;
  border-radius:4px;cursor:pointer;font-family:'Special Elite',monospace;font-size:12px;
  color:var(--muted);letter-spacing:.04em;transition:all .15s;display:flex;align-items:center;
  justify-content:center;gap:6px;
}
.tool-btn:hover{border-color:var(--ink);color:var(--ink)}
.tool-btn.active{border-color:var(--ink);color:var(--ink);background:rgba(26,20,16,.06)}
.color-row{display:flex;gap:5px;flex-wrap:wrap;margin-top:4px}
.color-dot{
  width:18px;height:18px;border-radius:50%;cursor:pointer;border:2px solid transparent;
  transition:border-color .15s;flex-shrink:0;
}
.color-dot.active{border-color:var(--ink)}
.row{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--muted);margin-bottom:6px}
.row>span{width:64px;flex-shrink:0;color:var(--ink)}
input[type=range]{flex:1;accent-color:#c0392b;height:3px}
.val{width:22px;text-align:right;flex-shrink:0;color:var(--muted)}

/* KEYWORD INPUT */
#kw-area{display:flex;flex-direction:column;gap:0}
#kw-input{
  width:100%;border:1px solid var(--border);background:var(--bg);
  color:var(--ink);border-radius:4px;padding:6px 10px;font-family:'Special Elite',monospace;
  font-size:13px;letter-spacing:.06em;outline:none;transition:border-color .15s;
}
#kw-input:focus{border-color:var(--ink)}
#kw-input::placeholder{color:var(--muted);font-family:'Outfit',sans-serif;font-size:11px;letter-spacing:.02em}
#kw-hint{font-size:10px;color:var(--muted);margin-top:5px;line-height:1.5}
#kw-tags{display:flex;flex-wrap:wrap;gap:4px;margin-top:8px}
.kw-tag{
  font-family:'Special Elite',monospace;font-size:11px;padding:2px 8px;
  border-radius:3px;border:1px solid;cursor:pointer;letter-spacing:.04em;
  display:flex;align-items:center;gap:4px;
}
.kw-tag .rm{font-size:9px;opacity:.5}
.kw-tag:hover .rm{opacity:1}

/* CANVAS WRAP */
#canvas-wrap{
  flex:1;overflow:hidden;position:relative;
  background:var(--bg);
  background-image:
    linear-gradient(rgba(0,0,0,.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,0,0,.03) 1px, transparent 1px);
  background-size:28px 28px;
}

/* SCROLL TRACK */
#scroll-track{
  display:flex;align-items:center;
  position:absolute;top:0;left:0;height:100%;
}

/* PAPER — 3 pages, shorter height */
.paper{
  position:relative;
  width:480px;
  height:calc(100vh - var(--header-h) - 120px);
  flex-shrink:0;
  background:var(--paper);
  margin:60px 24px;
  padding:36px 40px 40px;
  background-image:
    repeating-linear-gradient(0deg, transparent, transparent 27px, rgba(180,160,120,.07) 27px, rgba(180,160,120,.07) 28px);
  overflow:hidden;
}

/* TEXT CONTENT */
.text-layer{
  position:relative;z-index:1;
  font-family:'IM Fell English',serif;
  line-height:1.65;
  user-select:none;
  height:100%;overflow:hidden;
}
.word-span{
  display:inline;position:relative;cursor:default;
  font-size:13.5px;
  transition:color .15s;
}
.word-space{display:inline;white-space:pre}

/* MARK EFFECTS */
.mark-highlight{
  position:relative;
  z-index:2;
}
.mark-redact{
  background:#1a1410;
  color:transparent;
  padding:0 2px;
  border-radius:1px;
}
.mark-strike{
  position:relative;
}
.mark-circle{
  position:relative;
  z-index:2;
}

/* SVG OVERLAY */
.svg-overlay{
  position:absolute;top:0;left:0;width:100%;height:100%;
  pointer-events:none;z-index:10;overflow:visible;
}
</style>
</head>
<body>

<header>
  <div class="brand">Mark<span>It</span> ✦</div>
  <div class="sep"></div>
  <button class="btn" id="btn-clear-marks">Clear marks</button>
  <button class="btn" id="btn-load-text">Load text</button>
  <button class="btn" id="btn-export">↓ PNG</button>
</header>

<div id="layout">
  <div id="panel">
    <div>
      <div class="ps-t">Mark type</div>
      <div style="display:flex;flex-direction:column;gap:5px">
        <button class="tool-btn active" data-tool="line">— connect with line</button>
        <button class="tool-btn" data-tool="highlight">◼ highlight</button>
        <button class="tool-btn" data-tool="redact">█ redact</button>
        <button class="tool-btn" data-tool="strike">⟵ strikethrough</button>
        <button class="tool-btn" data-tool="circle">○ circle</button>
      </div>
    </div>

    <div>
      <div class="ps-t">Brush style</div>
      <div style="display:flex;flex-direction:column;gap:5px">
        <button class="tool-btn" data-brush="ink">✒ Ink</button>
        <button class="tool-btn active" data-brush="brush">🖌 Brush</button>
        <button class="tool-btn" data-brush="pencil">✏ Pencil</button>
        <button class="tool-btn" data-brush="marker">▬ Marker</button>
      </div>
    </div>

    <div>
      <div class="ps-t">Stroke style</div>
      <div style="display:flex;flex-direction:column;gap:5px">
        <button class="tool-btn active" data-style="ink">Ink</button>
        <button class="tool-btn" data-style="brush">Brush</button>
        <button class="tool-btn" data-style="pencil">Pencil</button>
        <button class="tool-btn" data-style="marker">Marker</button>
      </div>
    </div>

    <div>
      <div class="ps-t">Line color</div>
      <div class="color-row" id="color-row"></div>
    </div>

    <div>
      <div class="ps-t">Line weight</div>
      <div class="row">
        <span>Width</span>
        <input type="range" id="sl-lw" min="1" max="5" step=".5" value="1.5">
        <span class="val" id="vl-lw">1.5</span>
      </div>
      <div class="row">
        <span>Opacity</span>
        <input type="range" id="sl-op" min="0.2" max="1" step=".05" value="0.75">
        <span class="val" id="vl-op">.75</span>
      </div>
    </div>

    <div>
      <div class="ps-t">Keyword</div>
      <div id="kw-area">
        <input type="text" id="kw-input" placeholder="type a word, press Enter…" autocomplete="off" spellcheck="false"/>
        <div id="kw-hint">Press <strong>Enter</strong> to mark all matches in the text.</div>
        <div id="kw-tags"></div>
      </div>
    </div>

    <div>
      <div class="ps-t">Text</div>
      <textarea id="txt-input" style="width:100%;height:120px;background:var(--bg);color:var(--ink);border:1px solid var(--border);border-radius:4px;padding:8px;font-family:'IM Fell English',serif;font-size:12px;resize:vertical;outline:none;line-height:1.6" placeholder="Paste your text here…"></textarea>
      <button class="btn" style="margin-top:6px;width:100%" id="btn-apply-text">Apply text</button>
    </div>
  </div>

  <div id="canvas-wrap">
    <div id="scroll-track"></div>
  </div>
</div>

<script>
// ── Default text chunks — 3 pages ──
var PAGE_TEXTS = [
  `The relationship between language and thought has occupied philosophers since antiquity. Wittgenstein argued that the limits of one's language are the limits of one's world.

Benjamin's concept of aura — that quality of presence, of unrepeatable occurrence — erodes in the age of mechanical reproduction. Yet the copy proliferates meaning even as it evacuates the original.

Memory is not storage but reconstruction. Each recollection is a new act, shaped by intervening experience, desire, and the present moment's demands.`,

  `The archive speaks only to those who already know what they are looking for. The document does not answer; it waits. History is the art of asking the right question.

Rhizome versus tree. The arboreal structure presupposes a root, a foundation, a hierarchy of branches. The rhizome spreads laterally, without center, without origin.

In topology, a surface may be transformed continuously without tearing. The coffee cup and the donut are the same. Form is preserved through deformation.`,

  `Barthes distinguishes the studium from the punctum: the former a cultural, coded field of interest; the latter a wound, a prick — the accidental detail that pierces the reader.

Language game, form of life, family resemblance. Ordinary language philosophy insists that meaning is use — not reference, not mental image, but participation in shared practice.

The symptom speaks where the subject cannot. Repression does not erase but displaces — the return of the repressed in dream, in slip, in symptom.`,
];

var currentTool = 'line';
var currentColor = '#c0392b';
var lineWidth = 1.5;
var lineOpacity = 0.75;
var brushMode = 'brush';
var keywords = [];
var allWordSpans = [];
var PAGE_COUNT = 3;
var SCROLL_SPEED = 25;
var paused = false;

var COLORS = [
  '#c0392b','#2980b9','#27ae60','#8e44ad',
  '#e67e22','#16a085','#2c3e50','#7f8c8d',
  '#f39c12','#1abc9c'
];

function init(){
  buildColorRow();
  buildPages();
  bindEvents();
  startScroll();
}

function buildPages(){
  var track = document.getElementById('scroll-track');
  track.innerHTML = '';
  allWordSpans = [];

  var pages = [];
  for(var i=0;i<PAGE_COUNT;i++) pages.push(i);
  var allPages = pages.concat(pages);

  allPages.forEach(function(idx){
    var paper = document.createElement('div');
    paper.className = 'paper';

    var textLayer = document.createElement('div');
    textLayer.className = 'text-layer';

    var svg = document.createElementNS('http://www.w3.org/2000/svg','svg');
    svg.setAttribute('class','svg-overlay');

    var spans = buildTextInto(textLayer, PAGE_TEXTS[idx]);
    allWordSpans = allWordSpans.concat(spans);

    paper.appendChild(textLayer);
    paper.appendChild(svg);
    track.appendChild(paper);
  });

  track.style.width = (allPages.length * 528) + 'px';
}

function buildTextInto(layer, text){
  layer.innerHTML = '';
  var spans = [];
  var paragraphs = text.split(/\n+/);
  var sizes = [13, 13.5, 12.5, 14, 13, 12];

  paragraphs.forEach(function(para, pi){
    if(!para.trim()) return;
    var p = document.createElement('p');
    p.style.marginBottom = '18px';
    p.style.fontSize = (sizes[pi % sizes.length]) + 'px';
    if(pi % 3 === 1) p.style.transform = 'rotate(-0.15deg)';
    if(pi % 5 === 3) p.style.transform = 'rotate(0.1deg)';

    var tokens = para.split(/(\s+)/);
    tokens.forEach(function(tok){
      if(/^\s+$/.test(tok)){
        var sp = document.createElement('span');
        sp.className = 'word-space';
        sp.textContent = tok;
        p.appendChild(sp);
      } else {
        var parts = tok.split(/(?=[,\.;:!?—])|(?<=[,\.;:!?—])/);
        parts.forEach(function(part){
          if(!part) return;
          var sp = document.createElement('span');
          sp.className = 'word-span';
          sp.textContent = part;
          sp.dataset.word = part.replace(/[^a-zA-Z0-9\u4e00-\u9fff]/g,'').toLowerCase();
          spans.push(sp);
          p.appendChild(sp);
        });
      }
    });
    layer.appendChild(p);
  });
  return spans;
}

function startScroll(){
  var track = document.getElementById('scroll-track');
  var totalW = PAGE_COUNT * 528;
  var dur = SCROLL_SPEED;

  track.style.animation = 'none';
  track.style.transform = 'translateX(0)';

  var startTime = null;
  var offset = 0;

  function tick(ts){
    if(!startTime) startTime = ts;
    if(!paused){
      var elapsed = (ts - startTime) / 1000;
      offset = (elapsed * (totalW / dur)) % totalW;
      track.style.transform = 'translateX(-' + offset + 'px)';
    } else {
      startTime = ts - (offset / (totalW / dur)) * 1000;
    }
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
}

document.addEventListener('DOMContentLoaded', function(){
  var cw = document.getElementById('canvas-wrap');
  if(cw){
    cw.addEventListener('mouseenter', function(){ paused = true; });
    cw.addEventListener('mouseleave', function(){ paused = false; });
  }
});

// ── Brush helpers: hand-drawn quality ──
function brushLine(svg, pts, color, lw, op){
  if(pts.length < 2) return;
  
  // draw 3-5 overlapping strokes for texture
  var strokes = 3 + Math.floor(Math.random() * 2);
  for(var s=0; s<strokes; s++){
    var path = document.createElementNS('http://www.w3.org/2000/svg','path');
    var d = 'M' + r(pts[0].x) + ',' + r(pts[0].y);
    
    for(var i=1; i<pts.length; i++){
      var prev = pts[i-1];
      var curr = pts[i];
      
      // add wobble
      var wobbleX = (Math.random() - 0.5) * 2;
      var wobbleY = (Math.random() - 0.5) * 2;
      
      var cp1x = prev.x + (curr.x - prev.x) * 0.3 + wobbleX;
      var cp1y = prev.y + (curr.y - prev.y) * 0.3 + wobbleY;
      var cp2x = prev.x + (curr.x - prev.x) * 0.7 + wobbleX;
      var cp2y = prev.y + (curr.y - prev.y) * 0.7 + wobbleY;
      
      d += ' C' + r(cp1x) + ',' + r(cp1y) + ' ' + r(cp2x) + ',' + r(cp2y) + ' ' + r(curr.x + wobbleX) + ',' + r(curr.y + wobbleY);
    }
    
    path.setAttribute('d', d);
    path.setAttribute('fill', 'none');
    path.setAttribute('stroke', color);
    path.setAttribute('stroke-width', lw * (0.7 + Math.random() * 0.6));
    path.setAttribute('stroke-opacity', op * (0.3 + s * 0.2));
    path.setAttribute('stroke-linecap', 'round');
    path.setAttribute('stroke-linejoin', 'round');
    svg.appendChild(path);
  }
  
  // dots at each point
  pts.forEach(function(pt){
    for(var d=0; d<3; d++){
      var dot = document.createElementNS('http://www.w3.org/2000/svg','circle');
      dot.setAttribute('cx', pt.x + (Math.random() - 0.5) * 1.5);
      dot.setAttribute('cy', pt.y + (Math.random() - 0.5) * 1.5);
      dot.setAttribute('r', lw * (1.5 + Math.random() * 0.8));
      dot.setAttribute('fill', color);
      dot.setAttribute('fill-opacity', op * (0.2 + d * 0.15));
      svg.appendChild(dot);
    }
  });
  
  animateStroke(svg.lastChild);
}

function brushCircle(svg, cx, cy, rx, ry, color){
  var strokes = 2 + Math.floor(Math.random() * 2);
  
  for(var s=0; s<strokes; s++){
    var el = document.createElementNS('http://www.w3.org/2000/svg','ellipse');
    var wobbleX = (Math.random() - 0.5) * 3;
    var wobbleY = (Math.random() - 0.5) * 3;
    var wobbleRx = (Math.random() - 0.5) * 2;
    var wobbleRy = (Math.random() - 0.5) * 2;
    
    el.setAttribute('cx', cx + wobbleX);
    el.setAttribute('cy', cy + wobbleY);
    el.setAttribute('rx', rx + wobbleRx);
    el.setAttribute('ry', ry + wobbleRy);
    el.setAttribute('fill', 'none');
    el.setAttribute('stroke', color);
    el.setAttribute('stroke-width', 1.2 + Math.random() * 0.6);
    el.setAttribute('stroke-opacity', 0.4 + s * 0.2);
    el.setAttribute('transform', 'rotate(' + (Math.random() * 8 - 4) + ',' + cx + ',' + cy + ')');
    svg.appendChild(el);
  }
}

function brushHighlight(sp, color){
  // multi-layer watercolor wash
  var layers = 3;
  for(var i=0; i<layers; i++){
    var layer = document.createElement('span');
    layer.style.position = 'absolute';
    layer.style.left = '-2px';
    layer.style.right = '-2px';
    layer.style.top = '-1px';
    layer.style.bottom = '-1px';
    layer.style.background = hexAlpha(color, 0.15 + i * 0.08);
    layer.style.borderRadius = (2 + i) + 'px';
    layer.style.filter = 'blur(' + (i * 0.5) + 'px)';
    layer.style.zIndex = '-1';
    sp.style.position = 'relative';
    sp.insertBefore(layer, sp.firstChild);
  }
}

function brushStrike(sp, color){
  // double strike with offset
  var strikes = 2;
  for(var i=0; i<strikes; i++){
    var line = document.createElement('span');
    line.style.position = 'absolute';
    line.style.left = '-2px';
    line.style.right = '-2px';
    line.style.top = '50%';
    line.style.height = '1.5px';
    line.style.background = color;
    line.style.transform = 'translateY(-50%) rotate(' + ((Math.random() - 0.5) * 2) + 'deg)';
    line.style.opacity = 0.6 + i * 0.2;
    line.style.pointerEvents = 'none';
    sp.style.position = 'relative';
    sp.appendChild(line);
  }
}

function animateStroke(el){
  if(!el || el.tagName !== 'circle') return;
  el.style.opacity = '0';
  el.style.transition = 'opacity 0.4s ease-out';
  requestAnimationFrame(function(){
    requestAnimationFrame(function(){
      el.style.opacity = el.getAttribute('fill-opacity') || '1';
    });
  });
}

function markKeyword(kw){
  var tool = currentTool;
  var color = currentColor;
  var lw = lineWidth;
  var op = lineOpacity;
  var word = kw.toLowerCase().trim();
  if(!word) return;

  var matched = allWordSpans.filter(function(sp){
    var w = sp.dataset.word;
    return w === word || (word.length > 3 && w.includes(word)) || (w.length > 3 && word.includes(w));
  });
  if(!matched.length) return;

  if(tool === 'line'){
    groupByPaper(matched).forEach(function(group){
      if(group.length >= 2) applyLineConnections(group, color, lw, op);
    });
  } else {
    matched.forEach(function(sp){ applyMarkToSpan(sp, tool, color); });
  }

  keywords.push({word:kw, color:color, tool:tool});
  renderTags();
}

function groupByPaper(spans){
  var groups = [];
  spans.forEach(function(sp){
    var paper = sp.closest('.paper');
    var g = groups.find(function(x){ return x.paper === paper; });
    if(g) g.spans.push(sp);
    else groups.push({paper:paper, spans:[sp]});
  });
  return groups.map(function(g){ return g.spans; });
}

function applyMarkToSpan(sp, tool, color){
  sp.classList.remove('mark-highlight','mark-redact','mark-strike','mark-circle');
  if(tool === 'highlight'){
    sp.classList.add('mark-highlight');
    brushHighlight(sp, color);
  } else if(tool === 'redact'){
    sp.classList.add('mark-redact');
  } else if(tool === 'strike'){
    sp.classList.add('mark-strike');
    brushStrike(sp, color);
  } else if(tool === 'circle'){
    sp.classList.add('mark-circle');
    drawCircleAroundSpan(sp, color);
  }
}

function applyLineConnections(spans, color, lw, op){
  if(spans.length < 2) return;
  var paper = spans[0].closest('.paper');
  var svg = paper.querySelector('.svg-overlay');
  var paperRect = paper.getBoundingClientRect();

  var pts = spans.map(function(sp){
    var r = sp.getBoundingClientRect();
    return {
      x: r.left - paperRect.left + r.width/2,
      y: r.top - paperRect.top + r.height/2,
      sp: sp
    };
  });

  spans.forEach(function(sp){
    brushHighlight(sp, color);
  });

  brushLine(svg, pts, color, lw, op);
}

function drawCircleAroundSpan(sp, color){
  var paper = sp.closest('.paper');
  var svg = paper.querySelector('.svg-overlay');
  var paperRect = paper.getBoundingClientRect();
  var r2 = sp.getBoundingClientRect();
  var cx = r2.left - paperRect.left + r2.width/2;
  var cy = r2.top - paperRect.top + r2.height/2;
  var rx = r2.width/2 + 6;
  var ry = r2.height/2 + 5;
  brushCircle(svg, cx, cy, rx, ry, color);
}

function renderTags(){
  var c = document.getElementById('kw-tags');
  c.innerHTML = '';
  keywords.forEach(function(kw, i){
    var tag = document.createElement('div');
    tag.className = 'kw-tag';
    tag.style.borderColor = kw.color;
    tag.style.color = kw.color;
    tag.innerHTML = kw.word + ' <span class="rm">✕</span>';
    tag.addEventListener('click', function(){
      keywords.splice(i,1);
      renderTags();
    });
    c.appendChild(tag);
  });
}

function bindEvents(){
  document.querySelectorAll('[data-tool]').forEach(function(btn){
    btn.addEventListener('click',function(){
      document.querySelectorAll('[data-tool]').forEach(function(b){b.classList.remove('active');});
      btn.classList.add('active');
      currentTool = btn.dataset.tool;
    });
  });

  document.querySelectorAll('[data-brush]').forEach(function(btn){
    btn.addEventListener('click',function(){
      document.querySelectorAll('[data-brush]').forEach(function(b){b.classList.remove('active');});
      btn.classList.add('active');
      brushMode = btn.dataset.brush;
    });
  });

  var slLw = document.getElementById('sl-lw');
  var vlLw = document.getElementById('vl-lw');
  slLw.addEventListener('input',function(){
    lineWidth = parseFloat(slLw.value);
    vlLw.textContent = lineWidth;
  });
  var slOp = document.getElementById('sl-op');
  var vlOp = document.getElementById('vl-op');
  slOp.addEventListener('input',function(){
    lineOpacity = parseFloat(slOp.value);
    vlOp.textContent = lineOpacity.toFixed(2);
  });

  var kwin = document.getElementById('kw-input');
  kwin.addEventListener('keydown', function(e){
    if(e.key === 'Enter'){
      e.preventDefault();
      var val = kwin.value.trim();
      if(val){ markKeyword(val); kwin.value = ''; }
    }
  });

  document.getElementById('btn-clear-marks').addEventListener('click', function(){
    document.querySelectorAll('.svg-overlay').forEach(function(svg){
      while(svg.lastChild) svg.removeChild(svg.lastChild);
    });
    allWordSpans.forEach(function(sp){
      sp.classList.remove('mark-highlight','mark-redact','mark-strike','mark-circle');
      sp.style.background = '';
      sp.style.position = '';
      sp.innerHTML = sp.textContent;
    });
    keywords = [];
    renderTags();
  });

  document.getElementById('btn-load-text').addEventListener('click', function(){
    var txt = document.getElementById('txt-input').value.trim();
    if(txt){
      var chunks = txt.split(/\n{2,}/);
      PAGE_TEXTS = [];
      var chunkSize = Math.ceil(chunks.length / PAGE_COUNT);
      for(var i=0;i<PAGE_COUNT;i++){
        PAGE_TEXTS.push(chunks.slice(i*chunkSize,(i+1)*chunkSize).join('\n\n') || PAGE_TEXTS[0]);
      }
      buildPages();
    }
  });
  document.getElementById('btn-apply-text').addEventListener('click', function(){
    document.getElementById('btn-load-text').click();
  });

  document.getElementById('btn-export').addEventListener('click', function(){
    alert('Export coming soon!');
  });
}

function r(n){ return Math.round(n*10)/10; }
function hexAlpha(hex, alpha){
  var res = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
  if(!res) return hex;
  return 'rgba('+parseInt(res[1],16)+','+parseInt(res[2],16)+','+parseInt(res[3],16)+','+alpha+')';
}

function buildColorRow(){
  var row = document.getElementById('color-row');
  row.innerHTML = '';
  COLORS.forEach(function(c){
    var d = document.createElement('div');
    d.className = 'color-dot' + (c===currentColor?' active':'');
    d.style.background = c;
    d.addEventListener('click', function(){
      currentColor = c;
      row.querySelectorAll('.color-dot').forEach(function(x){x.classList.remove('active');});
      d.classList.add('active');
    });
    row.appendChild(d);
  });
}

init();
</script>
</body>
</html>
