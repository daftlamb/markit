<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Mark It ✦</title>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500&family=IM+Fell+English:ital@0;1&family=Special+Elite&family=Noto+Serif+SC:wght@300;400;600&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#f5f0e8;--paper:#faf6ee;--ink:#1a1410;--muted:#7a6e60;
  --border:#d8cfc0;--accent:#2a2a2a;--header-h:48px;
}
html,body{height:100%;overflow:hidden;background:var(--bg);font-family:'Outfit',sans-serif;font-size:13px;color:var(--ink)}

/* HEADER */
header{
  height:var(--header-h);background:var(--paper);border-bottom:1px solid var(--border);
  display:flex;align-items:center;padding:0 20px;gap:12px;flex-shrink:0;z-index:100;position:relative;
}
.brand{font-family:'Special Elite',monospace;font-size:16px;letter-spacing:.04em;color:var(--ink)}
.brand span{color:#c0392b}
.sep{flex:1}
.btn{height:30px;border:1px solid var(--border);background:transparent;border-radius:4px;
  cursor:pointer;color:var(--ink);font-family:inherit;font-size:12px;padding:0 12px;
  transition:border-color .15s,color .15s;letter-spacing:.04em}
.btn:hover{border-color:var(--ink);color:var(--ink)}

/* LAYOUT */
#layout{display:flex;flex:1;height:calc(100vh - var(--header-h));overflow:hidden}

/* PANEL */
#panel{
  width:240px;flex-shrink:0;background:var(--paper);border-right:1px solid var(--border);
  display:flex;flex-direction:column;padding:16px 14px;gap:14px;overflow-y:auto;
}
.ps-t{font-size:9px;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);margin-bottom:8px;font-weight:500}
.tool-btn{
  width:100%;height:32px;border:1px solid var(--border);background:transparent;
  border-radius:4px;cursor:pointer;font-family:'Special Elite',monospace;font-size:12px;
  color:var(--muted);letter-spacing:.04em;transition:all .15s;display:flex;align-items:center;
  justify-content:center;gap:6px;
}
.tool-btn:hover{border-color:var(--ink);color:var(--ink)}
.tool-btn.active{border-color:var(--ink);color:var(--ink);background:rgba(26,20,16,.06)}
.color-row{display:flex;gap:5px;flex-wrap:wrap;margin-top:4px}
.color-dot{
  width:18px;height:18px;border-radius:50%;cursor:pointer;border:2px solid transparent;
  transition:border-color .15s;flex-shrink:0;
}
.color-dot.active{border-color:var(--ink)}
.row{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--muted);margin-bottom:6px}
.row>span{width:64px;flex-shrink:0;color:var(--ink)}
input[type=range]{flex:1;accent-color:#c0392b;height:3px}
.val{width:22px;text-align:right;flex-shrink:0;color:var(--muted)}

/* KEYWORD INPUT */
#kw-area{display:flex;flex-direction:column;gap:0}
#kw-input{
  width:100%;border:1px solid var(--border);background:var(--bg);
  color:var(--ink);border-radius:4px;padding:6px 10px;font-family:'Special Elite',monospace;
  font-size:13px;letter-spacing:.06em;outline:none;transition:border-color .15s;
}
#kw-input:focus{border-color:var(--ink)}
#kw-input::placeholder{color:var(--muted);font-family:'Outfit',sans-serif;font-size:11px;letter-spacing:.02em}
#kw-hint{font-size:10px;color:var(--muted);margin-top:5px;line-height:1.5}
#kw-tags{display:flex;flex-wrap:wrap;gap:4px;margin-top:8px}
.kw-tag{
  font-family:'Special Elite',monospace;font-size:11px;padding:2px 8px;
  border-radius:3px;border:1px solid;cursor:pointer;letter-spacing:.04em;
  display:flex;align-items:center;gap:4px;
}
.kw-tag .rm{font-size:9px;opacity:.5}
.kw-tag:hover .rm{opacity:1}

/* CANVAS WRAP */
#canvas-wrap{
  flex:1;overflow:hidden;position:relative;
  background:var(--bg);
  background-image:
    linear-gradient(rgba(0,0,0,.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,0,0,.03) 1px, transparent 1px);
  background-size:28px 28px;
}

/* SCROLL TRACK */
#scroll-track{
  display:flex;align-items:center;
  position:absolute;top:0;left:0;height:100%;
}

/* PAPER */
    <button class="tool-btn" id="btn-random-color">🎲 Random</button>
.paper{
  position:relative;
  width:480px;height:60vh;
  flex-shrink:0;
  background:var(--paper);
  margin:32px 20px;
  padding:36px 40px 44px;
  background-image:
    repeating-linear-gradient(0deg, transparent, transparent 27px, rgba(180,160,120,.07) 27px, rgba(180,160,120,.07) 28px);
  overflow:hidden;
}

/* TEXT CONTENT */
.text-layer{
  position:relative;z-index:1;
  font-family:'IM Fell English','Noto Serif SC',serif;
  line-height:1.65;
  user-select:none;
  height:100%;overflow:hidden;
}
.word-span{
  display:inline;position:relative;cursor:default;
  font-size:13.5px;
  transition:color .15s;
}
.word-space{display:inline;white-space:pre}

/* MARK EFFECTS */
.mark-highlight{
  background:rgba(255,220,50,.45);
  border-radius:1px;
  padding:0 1px;
}
.mark-redact{
  background:#1a1410;
  color:transparent;
  padding:0 2px;
  border-radius:1px;
}
.mark-strike{
  position:relative;
}
.mark-strike::after{
  content:'';position:absolute;left:-1px;right:-1px;
  top:50%;height:1.5px;
  background:#c0392b;
  transform:rotate(-0.5deg);
  pointer-events:none;
}

/* CANVAS OVERLAY */
.canvas-overlay{
  position:absolute;top:0;left:0;width:100%;height:100%;
  pointer-events:none;z-index:10;
}

/* INSERTED IMAGE */
.inserted-img{
  position:absolute;
  cursor:move;
  border:2px dashed transparent;
  transition:border-color .15s;
  z-index:5;
}
.inserted-img:hover{
  border-color:rgba(192,57,43,.3);
}
.inserted-img img{
  display:block;
  width:100%;
  height:100%;
  object-fit:contain;
  pointer-events:none;
}
</style>
</head>
<body>

<header>
  <div class="brand">Mark<span>It</span> ✦</div>
  <div class="sep"></div>
  <button class="btn" id="btn-clear-marks">Clear marks</button>
  <button class="btn" id="btn-export">↓ PNG</button>
</header>

<div id="layout">

  <!-- PANEL -->
  <div id="panel">

    <div>
      <div class="ps-t">Mark type</div>
      <div style="display:flex;flex-direction:column;gap:5px">
        <button class="tool-btn active" data-tool="line">— connect</button>
        <button class="tool-btn" data-tool="highlight">◼ highlight</button>
        <button class="tool-btn" data-tool="redact">█ redact</button>
        <button class="tool-btn" data-tool="strike">⟵ strike</button>
      </div>
    </div>

    <div>
      <div class="ps-t">Insert</div>
      <button class="btn" id="btn-insert-img" style="width:100%">+ Image</button>
      <input type="file" id="file-input" accept="image/*" style="display:none">
    </div>

    <div>
      <div class="ps-t">Line style</div>
      <div style="display:flex;flex-direction:column;gap:5px">
        <button class="style-btn active" data-style="ink">Ink</button>
        <button class="style-btn" data-style="brush">Brush</button>
        <button class="style-btn" data-style="pencil">Pencil</button>
        <button class="style-btn" data-style="marker">Marker</button>
      </div>
    </div>

    <div>
      <div class="ps-t">Color</div>
      <div class="color-row" id="color-row"></div>
    </div>

    <div>
      <div class="ps-t">Line weight</div>
      <div class="row">
        <span>Width</span>
        <input type="range" id="sl-lw" min="1" max="5" step=".5" value="1.5">
        <span class="val" id="vl-lw">1.5</span>
      </div>
      <div class="row">
        <span>Opacity</span>
        <input type="range" id="sl-op" min="0.2" max="1" step=".05" value="0.75">
        <span class="val" id="vl-op">.75</span>
      </div>
    </div>

    <div>
      <div class="ps-t">Keyword</div>
      <div id="kw-area">
        <input type="text" id="kw-input" placeholder="type a word, press Enter…" autocomplete="off" spellcheck="false"/>
        <div id="kw-hint">Press <strong>Enter</strong> to mark all matches.</div>
        <div id="kw-tags"></div>
      </div>
    </div>

  </div>

  <!-- CANVAS WRAP -->
  <div id="canvas-wrap">
    <div id="scroll-track"></div>
  </div>

</div>

<script>
// ── Page texts ──
var PAGE_TEXTS = [
  `语言与思想的关系自古以来就困扰着哲学家。维特根斯坦认为，一个人语言的界限就是他世界的界限——这一命题颠覆了思想先于表达的普通假设。

本雅明的"灵韵"概念——那种在场的品质，不可重复的发生——在机械复制时代消解了。然而复制品在抽空原作的同时也增殖了意义。

记忆不是存储而是重构。每一次回忆都是新的行为，被介入的经验、欲望和当下时刻的要求所塑造。`,

  `档案只对那些已经知道自己在寻找什么的人说话。文献不回答；它等待。历史是提出正确问题的艺术。

根茎对树。树状结构预设了根、基础、枝条的等级。根茎横向蔓延，没有中心，没有起源——多样性而非统一。

在拓扑学中，一个表面可以连续变形而不撕裂。咖啡杯和甜甜圈是同一个。形式在变形中保存。同一性在扭曲中存续。`,

  `巴特区分了 studium 和 punctum：前者是文化的、编码的兴趣场域；后者是伤口、刺痛——刺穿图像读者的偶然细节。

语言游戏、生活形式、家族相似。日常语言哲学坚持意义即使用——不是指称，不是心理图像，而是参与共享实践。

症状在主体无法言说之处说话。压抑不抹除而是转移——被压抑者在梦、口误、症状中回归。`,
];

var PAGE_COUNT = 3;
var SCROLL_SPEED = 40;
var currentTool = 'line';
var currentStyle = 'ink';
var currentColor = '#c0392b';
var lineWidth = 1.5;
var lineOpacity = 0.75;
var keywords = [];
var allWordSpans = [];
var paused = false;

var COLORS = [
  '#c0392b','#2980b9','#27ae60','#8e44ad',
  '#e67e22','#16a085','#2c3e50','#7f8c8d',
  '#f39c12','#1abc9c'
];

function init(){
  buildColorRow();
  buildPages();
  bindEvents();
  startScroll();
}

function buildColorRow(){
  var row = document.getElementById('color-row');
  row.innerHTML = '';
  COLORS.forEach(function(c){
    var d = document.createElement('div');
    d.className = 'color-dot' + (c===currentColor?' active':'');
    d.style.background = c;
    d.addEventListener('click', function(){
      currentColor = c;
      row.querySelectorAll('.color-dot').forEach(function(x){x.classList.remove('active');});
      d.classList.add('active');
    });
    row.appendChild(d);
  });
}

function buildPages(){
  var track = document.getElementById('scroll-track');
  track.innerHTML = '';
  allWordSpans = [];
  var pages = [];
  for(var i=0;i<PAGE_COUNT;i++) pages.push(i);
  var allPages = pages.concat(pages);

  allPages.forEach(function(idx){
    var paper = document.createElement('div');
    paper.className = 'paper';
    var textLayer = document.createElement('div');
    textLayer.className = 'text-layer';
    var canvas = document.createElement('canvas');
    canvas.className = 'canvas-overlay';
    var spans = buildTextInto(textLayer, PAGE_TEXTS[idx]);
    allWordSpans = allWordSpans.concat(spans);
    paper.appendChild(textLayer);
    paper.appendChild(canvas);
    track.appendChild(paper);
  });
  track.style.width = (allPages.length * 560) + 'px';
  resizeCanvases();
}

function resizeCanvases(){
  document.querySelectorAll('.canvas-overlay').forEach(function(c){
    var p = c.parentElement;
    c.width = p.offsetWidth;
    c.height = p.offsetHeight;
  });
}

function buildTextInto(layer, text){
  layer.innerHTML = '';
  var spans = [];
  var paragraphs = text.split(/\n+/);
  var sizes = [13, 13.5, 12.5, 14, 13, 12];
  paragraphs.forEach(function(para, pi){
    if(!para.trim()) return;
    var p = document.createElement('p');
    p.style.marginBottom = '18px';
    p.style.fontSize = (sizes[pi % sizes.length]) + 'px';
    if(pi % 3 === 1) p.style.transform = 'rotate(-0.15deg)';
    if(pi % 5 === 3) p.style.transform = 'rotate(0.1deg)';
    var tokens = para.split(/(\s+)/);
    tokens.forEach(function(tok){
      if(/^\s+$/.test(tok)){
        var sp = document.createElement('span');
        sp.className = 'word-space';
        sp.textContent = tok;
        p.appendChild(sp);
      } else {
        var parts = tok.split(/(?=[,\.;:!?—])|(?<=[,\.;:!?—])/);
        parts.forEach(function(part){
          if(!part) return;
          var sp = document.createElement('span');
          sp.className = 'word-span';
          sp.textContent = part;
          sp.dataset.word = part.replace(/[^a-zA-Z0-9\u4e00-\u9fff]/g,'').toLowerCase();
          spans.push(sp);
          p.appendChild(sp);
        });
      }
    });
    layer.appendChild(p);
  });
  return spans;
}

function startScroll(){
  var track = document.getElementById('scroll-track');
  var totalW = PAGE_COUNT * 560;
  var startTime = null;
  var offset = 0;
  function tick(ts){
    if(!startTime) startTime = ts;
    if(!paused){
      var elapsed = (ts - startTime) / 1000;
      offset = (elapsed * (totalW / SCROLL_SPEED)) % totalW;
      track.style.transform = 'translateX(-' + offset + 'px)';
    } else {
      startTime = ts - (offset / (totalW / SCROLL_SPEED)) * 1000;
    }
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
}

document.addEventListener('DOMContentLoaded', function(){
  var cw = document.getElementById('canvas-wrap');
  if(cw){
    cw.addEventListener('mouseenter', function(){ paused = true; });
    cw.addEventListener('mouseleave', function(){ paused = false; });
  }
});

function markKeyword(kw){
  var tool = currentTool;
  var style = currentStyle;
  var color = currentColor;
  var lw = lineWidth;
  var op = lineOpacity;
  var word = kw.toLowerCase().trim();
  if(!word) return;
  var matched = allWordSpans.filter(function(sp){
    var w = sp.dataset.word;
    return w === word || (word.length > 3 && w.includes(word)) || (w.length > 3 && word.includes(w));
  });
  if(!matched.length) return;
  if(tool === 'line'){
    groupByPaper(matched).forEach(function(group){
      if(group.length >= 2) drawLineConnections(group, color, lw, op, style);
    });
  } else {
    matched.forEach(function(sp){ applyMarkToSpan(sp, tool, color); });
  }
  keywords.push({word:kw, color:color, tool:tool});
  renderTags();
}

function groupByPaper(spans){
  var groups = [];
  spans.forEach(function(sp){
    var paper = sp.closest('.paper');
    var g = groups.find(function(x){ return x.paper === paper; });
    if(g) g.spans.push(sp);
    else groups.push({paper:paper, spans:[sp]});
  });
  return groups.map(function(g){ return g.spans; });
}

function applyMarkToSpan(sp, tool, color){
  sp.classList.remove('mark-highlight','mark-redact','mark-strike');
  if(tool === 'highlight'){
    sp.classList.add('mark-highlight');
    sp.style.background = hexAlpha(color, 0.4);
  } else if(tool === 'redact'){
    sp.classList.add('mark-redact');
  } else if(tool === 'strike'){
    sp.classList.add('mark-strike');
    sp.style.textDecoration = 'line-through';
    sp.style.textDecorationColor = color;
    sp.style.textDecorationThickness = '1.5px';
  }
}

function drawLineConnections(spans, color, lw, op, style){
  if(spans.length < 2) return;
  var paper = spans[0].closest('.paper');
  var canvas = paper.querySelector('.canvas-overlay');
  var ctx = canvas.getContext('2d');
  var paperRect = paper.getBoundingClientRect();
  var pts = spans.map(function(sp){
    var r = sp.getBoundingClientRect();
    return {
      x: r.left - paperRect.left + r.width/2,
      y: r.top - paperRect.top + r.height/2
    };
  });
  spans.forEach(function(sp){
    sp.style.background = hexAlpha(color, 0.15);
    sp.style.borderRadius = '2px';
    sp.style.padding = '0 1px';
  });
  if(style === 'ink') drawInkLine(ctx, pts, color, lw, op);
  else if(style === 'brush') drawBrushLine(ctx, pts, color, lw, op);
  else if(style === 'pencil') drawPencilLine(ctx, pts, color, lw, op);
  else if(style === 'marker') drawMarkerLine(ctx, pts, color, lw, op);
}

function drawInkLine(ctx, pts, color, lw, op){
  ctx.globalAlpha = op;
  ctx.strokeStyle = color;
  ctx.lineWidth = lw;
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';
  ctx.beginPath();
  ctx.moveTo(pts[0].x, pts[0].y);
  for(var i=0;i<pts.length-1;i++){
    var p0 = pts[Math.max(0,i-1)];
    var p1 = pts[i];
    var p2 = pts[i+1];
    var p3 = pts[Math.min(pts.length-1,i+2)];
    var cp1x = p1.x + (p2.x-p0.x)/6 + (Math.random()-.5)*8;
    var cp1y = p1.y + (p2.y-p0.y)/6 + (Math.random()-.5)*8;
    var cp2x = p2.x - (p3.x-p1.x)/6 + (Math.random()-.5)*8;
    var cp2y = p2.y - (p3.y-p1.y)/6 + (Math.random()-.5)*8;
    ctx.bezierCurveTo(cp1x, cp1y, cp2x, cp2y, p2.x, p2.y);
  }
  ctx.stroke();
  pts.forEach(function(pt){
    ctx.beginPath();
    ctx.arc(pt.x, pt.y, lw*2, 0, Math.PI*2);
    ctx.fillStyle = color;
    ctx.fill();
  });
  ctx.globalAlpha = 1;
}

function drawBrushLine(ctx, pts, color, lw, op){
  var layers = 5;
  for(var l=0;l<layers;l++){
    ctx.globalAlpha = op / layers;
    ctx.strokeStyle = color;
    ctx.lineWidth = lw + Math.random()*0.8;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(pts[0].x + (Math.random()-.5)*2, pts[0].y + (Math.random()-.5)*2);
    for(var i=1;i<pts.length;i++){
      var p0 = pts[Math.max(0,i-1)];
      var p1 = pts[i];
      var jx = (Math.random()-.5)*3;
      var jy = (Math.random()-.5)*3;
      var cpx = (p0.x + p1.x)/2 + jx;
      var cpy = (p0.y + p1.y)/2 + jy;
      ctx.quadraticCurveTo(p0.x+jx, p0.y+jy, cpx, cpy);
    }
    ctx.stroke();
  }
  ctx.globalAlpha = 1;
}

function drawPencilLine(ctx, pts, color, lw, op){
  var layers = 8;
  for(var l=0;l<layers;l++){
    ctx.globalAlpha = op / (layers*1.5);
    ctx.strokeStyle = color;
    ctx.lineWidth = lw * 0.6;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(pts[0].x + (Math.random()-.5)*1.5, pts[0].y + (Math.random()-.5)*1.5);
    for(var i=1;i<pts.length;i++){
      var p0 = pts[Math.max(0,i-1)];
      var p1 = pts[i];
      var jx = (Math.random()-.5)*2;
      var jy = (Math.random()-.5)*2;
      var cpx = (p0.x + p1.x)/2 + jx;
      var cpy = (p0.y + p1.y)/2 + jy;
      ctx.quadraticCurveTo(p0.x+jx, p0.y+jy, cpx, cpy);
    }
    ctx.stroke();
  }
  ctx.globalAlpha = 1;
}

function drawMarkerLine(ctx, pts, color, lw, op){
  ctx.globalAlpha = op * 0.6;
  ctx.strokeStyle = color;
  ctx.lineWidth = lw * 3;
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';
  ctx.beginPath();
  ctx.moveTo(pts[0].x, pts[0].y);
  for(var i=1;i<pts.length;i++){
    ctx.lineTo(pts[i].x, pts[i].y);
  }
  ctx.stroke();
  ctx.globalAlpha = 1;
}

function renderTags(){
  var c = document.getElementById('kw-tags');
  c.innerHTML = '';
  keywords.forEach(function(kw, i){
    var tag = document.createElement('div');
    tag.className = 'kw-tag';
    tag.style.borderColor = kw.color;
    tag.style.color = kw.color;
    tag.innerHTML = kw.word + ' <span class="rm">✕</span>';
    tag.addEventListener('click', function(){
      keywords.splice(i,1);
      renderTags();
    });
    c.appendChild(tag);
  });
}

function bindEvents(){
  document.querySelectorAll('.tool-btn').forEach(function(btn){
    btn.addEventListener('click',function(){
      document.querySelectorAll('.tool-btn').forEach(function(b){b.classList.remove('active');});
      btn.classList.add('active');
      currentTool = btn.dataset.tool;
    });
  });
  document.querySelectorAll('.style-btn').forEach(function(btn){
    btn.addEventListener('click',function(){
      document.querySelectorAll('.style-btn').forEach(function(b){b.classList.remove('active');});
      btn.classList.add('active');
      currentStyle = btn.dataset.style;
    });
  });
  var slLw = document.getElementById('sl-lw');
  var vlLw = document.getElementById('vl-lw');
  slLw.addEventListener('input',function(){
    lineWidth = parseFloat(slLw.value);
    vlLw.textContent = lineWidth;
  });
  var slOp = document.getElementById('sl-op');
  var vlOp = document.getElementById('vl-op');
  slOp.addEventListener('input',function(){
    lineOpacity = parseFloat(slOp.value);
    vlOp.textContent = lineOpacity.toFixed(2);
  });
  var kwin = document.getElementById('kw-input');
  kwin.addEventListener('keydown', function(e){
    if(e.key === 'Enter'){
      e.preventDefault();
      var val = kwin.value.trim();
      if(val){ markKeyword(val); kwin.value = ''; }
    }
  });
  document.getElementById('btn-clear-marks').addEventListener('click', function(){
    document.querySelectorAll('.canvas-overlay').forEach(function(c){
      var ctx = c.getContext('2d');
      ctx.clearRect(0,0,c.width,c.height);
    });
    allWordSpans.forEach(function(sp){
      sp.classList.remove('mark-highlight','mark-redact','mark-strike');
      sp.style.background = '';
      sp.style.textDecoration = '';
      sp.style.padding = '';
      sp.style.borderRadius = '';
    });
    keywords = [];
    renderTags();
  });
  document.getElementById('btn-export').addEventListener('click', function(){
    alert('Export coming soon!');
  });
  
  // Image insert
  document.getElementById('btn-insert-img').addEventListener('click', function(){
    document.getElementById('file-input').click();
  });
  document.getElementById('file-input').addEventListener('change', function(e){
    var file = e.target.files[0];
    if(!file) return;
    var reader = new FileReader();
    reader.onload = function(ev){
      insertImageIntoPaper(ev.target.result);
    };
    reader.readAsDataURL(file);
    e.target.value = '';
  });
}

function hexAlpha(hex, alpha){
  var res = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
  if(!res) return hex;
  return 'rgba('+parseInt(res[1],16)+','+parseInt(res[2],16)+','+parseInt(res[3],16)+','+alpha+')';
}

function insertImageIntoPaper(dataURL){
  var papers = document.querySelectorAll('.paper');
  var targetPaper = papers[0];
  var wrap = document.createElement('div');
  wrap.className = 'inserted-img';
  wrap.style.left = '50px';
  wrap.style.top = '50px';
  wrap.style.width = '120px';
  wrap.style.height = '120px';
  var img = document.createElement('img');
  img.src = dataURL;
  wrap.appendChild(img);
  targetPaper.appendChild(wrap);
  makeDraggable(wrap);
}

function makeDraggable(el){
  var isDragging = false;
  var startX, startY, initialLeft, initialTop;
  el.addEventListener('mousedown', function(e){
    isDragging = true;
    startX = e.clientX;
    startY = e.clientY;
    initialLeft = parseInt(el.style.left) || 0;
    initialTop = parseInt(el.style.top) || 0;
    el.style.cursor = 'grabbing';
    e.preventDefault();
  });
  document.addEventListener('mousemove', function(e){
    if(!isDragging) return;
    var dx = e.clientX - startX;
    var dy = e.clientY - startY;
    el.style.left = (initialLeft + dx) + 'px';
    el.style.top = (initialTop + dy) + 'px';
  });
  document.addEventListener('mouseup', function(){
    if(isDragging){
      isDragging = false;
      el.style.cursor = 'move';
    }
  });
}

init();
</script>
</body>
</html>
